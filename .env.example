# Database Connection URL
# For SQLite (Default):
# DATABASE_URL=sqlite:///data/ppe_monitoring.db

# For MySQL (Change username, password, host, port, db_name accordingly):
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ppe_monitoring_db

